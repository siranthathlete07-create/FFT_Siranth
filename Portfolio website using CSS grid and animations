border-radius: 5px;

transition: 0.3s;

}

.project:hover {

transform: translateY(-5px);

}

form {

background-color: rgb(23, 221, 106);

width: 350px;

max-width: 80%;

margin: auto;

padding: 20px;

}



input, textarea {

width: 90%;

padding: 10px;

margin: 8px;

}

button {

padding: 10px 20px;

background-color: red;

color: rgb(21, 201, 225);

border: none;

}

@keyframes show {

from {

opacity: 0;

}

to {

opacity: 1;

}

}

@media (max-width: 600px) {

.skills,

.projects {

grid-template-columns: 1fr;

}

nav a {

display: block;

margin: 8px;

}

.home h1 {

font-size: 28px;

}

}

</style>

